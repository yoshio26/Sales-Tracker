{
  "name": "sales-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"npm --prefix FrontEnd run dev\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p FrontEnd/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm --prefix FrontEnd run build && tsc -p tsconfig.server.json",
    "test:dev-auth-flow": "vitest run tests/dev-auth-flow.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "nodemailer": "10.0.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/node": "24.13.3",
    "@types/nodemailer": "7.0.4",
    "concurrently": "9.2.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.0.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
