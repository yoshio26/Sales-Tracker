{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["server/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
