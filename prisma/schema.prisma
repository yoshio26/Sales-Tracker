generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(320)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  products      Product[]
  expenses      Expense[]
  stockPurchases StockPurchase[]

  @@map("users")
}

model Product {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(200)
  category   String    @db.VarChar(100)
  priceCents Int       @default(0) @map("price_cents")
  stockQuantity Int     @default(0) @map("stock_quantity")
  active     Boolean   @default(true)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  stockPurchases StockPurchase[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([userId, active, deletedAt])
  @@index([userId, category])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt])
  @@map("products")
}

model AllowedEmail {
  email       String      @id @db.VarChar(320)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("allowed_emails")
}

model LoginCode {
  id          String        @id @default(uuid()) @db.Uuid
  email       String        @db.VarChar(320)
  codeHash    String        @map("code_hash") @db.VarChar(255)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  attempts    Int           @default(0)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([email, expiresAt])
  @@index([expiresAt])
  @@map("login_codes")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RateLimitEvent {
  id        String   @id @default(uuid()) @db.Uuid
  bucket    String   @db.VarChar(20)
  keyHash   String   @map("key_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([bucket, keyHash, createdAt])
  @@index([createdAt])
  @@map("rate_limit_events")
}

model Expense {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  productNameSnapshot String    @map("product_name_snapshot") @db.VarChar(200)
  categorySnapshot    String    @map("category_snapshot") @db.VarChar(100)
  amountCents         Int       @map("amount_cents")
  quantity            Int       @default(1)
  note                String?
  spentAt             DateTime  @map("spent_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product   @relation(fields: [productId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, deletedAt, spentAt])
  @@index([userId, productId, deletedAt])
  @@index([userId, categorySnapshot, deletedAt])
  @@index([userId, deletedAt, updatedAt])
  @@map("expenses")
}

model StockPurchase {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  productNameSnapshot  String   @map("product_name_snapshot") @db.VarChar(200)
  categorySnapshot     String   @map("category_snapshot") @db.VarChar(100)
  quantity             Int
  totalCostCents       Int      @map("total_cost_cents")
  purchasedAt          DateTime @default(now()) @map("purchased_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId, userId], references: [id, userId], onDelete: Restrict)

  @@index([userId, purchasedAt])
  @@index([userId, productId, purchasedAt])
  @@index([userId, deletedAt])
  @@map("stock_purchases")
}
