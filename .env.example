NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sales_tracker
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail-address
# Mailpit development alternative:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.test
COOKIE_SECURE=false
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_IP_MAX=20
ALLOWLIST_EMAIL=you@example.com
